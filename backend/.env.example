# Copie a infra/.env (NO se versiona). Genere claves propias; nunca reutilice estas.
POSTGRES_PASSWORD=cambie-esto-por-una-clave-larga-y-aleatoria
PUERTO_WEB=8080

# Motor de IA: cambiar de modelo = cambiar estas variables.
EVALUADOR_IA_PROVEEDOR=openai_compatible   # openai_compatible (Ollama/vLLM/OpenRouter) | anthropic
EVALUADOR_IA_MODELO=qwen2.5:7b
EVALUADOR_IA_BASE_URL=http://host.docker.internal:11434/v1
EVALUADOR_IA_API_KEY=

# Solo desarrollo (backend/compose.yml): crea el tenant "demo" con un usuario por rol.
# EVALUADOR_SEMILLA_CLAVE=

# Cifrado AES-256 de documentos. Genere una con: openssl rand -base64 32  (si se pierde, no se pueden recuperar)
EVALUADOR_CLAVE_CIFRADO=

# Firma los tokens de sesión (JWT). Mínimo 32 caracteres; obligatorio en producción. Genere una con: openssl rand -base64 48
EVALUADOR_JWT_SECRET=

# Evaluación en la plataforma y búsqueda opcional de precios de mercado (requiere OpenRouter).
EVALUADOR_EVALUATION_PARALLELISM=3
EVALUADOR_MARKET_SEARCH_ENABLED=true
EVALUADOR_ORIGENES_CORS='["http://localhost:8081"]'

# Rol de la cuenta de demostración: cargador, o coordinador (carga, evalúa y verifica; no adjudica).
EVALUADOR_USUARIO_DEMO_ROL=cargador

# Asistente de presupuestos. Modelo vacío = EVALUADOR_IA_MODELO. Debe admitir llamadas a herramientas.
EVALUADOR_ASSISTANT_MODEL=
# La búsqueda web del asistente envía solo la descripción del producto.
EVALUADOR_ASSISTANT_MARKET_SEARCH_ENABLED=false

# Registro de cuentas (cada cuenta puede gastar saldo de IA) y asistente aún sin validar.
EVALUADOR_REGISTRATION_ENABLED=true
EVALUADOR_ASSISTANT_ENABLED=false
