# Copia a .env y rellena. Lo lee docker compose.
POSTGRES_PASSWORD=cambia-esto
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio   # openssl rand -hex 32 (mín. 32 caracteres en producción)
# Clave para cifrar los tokens de WhatsApp guardados en la BD (openssl rand -hex 32). Si se deja vacía se deriva de JWT_SECRET.
DATA_KEY=
# URL pública donde se sirve la app (sin barra final). Meta necesita HTTPS.
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080
# Agente IA: sin clave el agente no responde
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_TIMEZONE=Europe/Madrid
# Opcional: valida la firma X-Hub-Signature-256 de los webhooks de Meta
META_APP_SECRET=   # OBLIGATORIO en producción: sin él el backend rechaza los webhooks de WhatsApp
# Tasa oficial BCV (Bs/USD) para la actualización automática de precios
BCV_RATE_URL=https://ve.dolarapi.com/v1/dolares/oficial
