PORT=3000
DB_HOST=localhost
DB_PORT=5433
DB_USER=crm
DB_PASS=crm_dev
DB_NAME=crm_bot
JWT_SECRET=dev-only-change-me
CORS_ORIGIN=http://localhost:4200
# Agente IA (Anthropic). Sin clave el agente no responde.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_TIMEZONE=Europe/Madrid
# WhatsApp (Meta). APP_SECRET opcional: si se define se valida X-Hub-Signature-256.
META_APP_SECRET=
PUBLIC_URL=http://localhost:3000
# En producción META_APP_SECRET es obligatorio y JWT_SECRET debe tener >= 32 caracteres.
DATA_KEY=
# Detrás de un proxy (nginx): número de saltos de confianza, para el límite de peticiones por IP
# TRUST_PROXY=1
# Tasa oficial BCV (Bs/USD)
BCV_RATE_URL=https://ve.dolarapi.com/v1/dolares/oficial
# Solo desarrollo: permite webhooks salientes hacia localhost/redes privadas (en producción se bloquean: SSRF)
# ALLOW_PRIVATE_WEBHOOKS=true
# SCHEDULER=off desactiva recordatorios y automatizaciones programadas
