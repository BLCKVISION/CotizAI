{
	auto_https off   # el TLS lo termina el ingreso del evento / proxy superior; internamente HTTP
	admin off
}

:8080 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /_expo/static/* Cache-Control "public, max-age=31536000, immutable"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}
}
