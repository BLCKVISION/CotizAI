{
  "expo": {
    "name": "CotizAI",
    "slug": "evaluador-propuestas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "CotizAI · Evaluación de propuestas",
      "shortName": "CotizAI",
      "description": "Evaluación explicable de propuestas de compra con revisión del comité",
      "lang": "es",
      "themeColor": "#0B1F3A",
      "backgroundColor": "#F5F6F8"
    },
    "scheme": "evaluador",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
